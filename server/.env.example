# Porta do servidor
PORT=4000

# Intervalo (minutos) para checar os feeds automaticamente
CHECK_INTERVAL_MINUTES=15

# Formato padrão da imagem gerada: square (1080x1080) ou portrait (1080x1350)
IMAGE_FORMAT=square

# IA gratuita (Pollinations - não precisa de chave). Deixe "true" para gerar
# legenda/hashtags e imagem de fallback automaticamente.
AI_ENABLED=true

# Google Drive (opcional) - para salvar automaticamente as imagens geradas.
# 1. Crie um projeto no Google Cloud Console e ative a Google Drive API.
# 2. Crie uma Service Account e gere uma chave JSON.
# 3. Compartilhe a pasta do Drive de destino com o e-mail da service account.
# 4. Coloque o caminho do arquivo JSON abaixo e o ID da pasta.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_AUTO_SAVE=false
