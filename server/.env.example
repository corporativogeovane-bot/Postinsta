# Porta do servidor
PORT=4000

# Intervalo (minutos) para checar os feeds automaticamente
CHECK_INTERVAL_MINUTES=15

# Formato padrão da imagem gerada: square (1080x1080) ou portrait (1080x1350)
IMAGE_FORMAT=square

# IA gratuita (Pollinations - não precisa de chave). Deixe "true" para gerar
# legenda/hashtags e imagem de fallback automaticamente.
AI_ENABLED=true

# Dropbox (opcional) - para salvar automaticamente as imagens geradas.
# 1. Crie um app em https://www.dropbox.com/developers/apps (tipo "Scoped access",
#    acesso "App folder" ou "Full Dropbox").
# 2. Nas permissões do app, ative files.content.write, files.content.read e
#    sharing.write (para gerar o link de visualização).
# 3. Na aba "Settings" do app, gere um Access Token ("Generated access token").
# 4. Coloque o token abaixo e o caminho da pasta onde salvar (será criada
#    automaticamente na primeira imagem enviada).
DROPBOX_ACCESS_TOKEN=
DROPBOX_FOLDER_PATH=/Postinsta
DROPBOX_AUTO_SAVE=false
